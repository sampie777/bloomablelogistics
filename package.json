{
  "name": "bloomablelogistics",
  "version": "1.15.0-SNAPSHOT",
  "private": true,
  "scripts": {
    "postinstall": "patch-package",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "bundle": "cd android && ./gradlew bundleRelease",
    "build": "cd android && ./gradlew assembleRelease",
    "device-install": "adb -d install \"$(ls -t ./android/app/build/outputs/apk/release/*.apk | head -1)\"",
    "device-install-windows": "adb -d install \"./android/app/build/outputs/apk/release/$(Get-ChildItem -Path ./android/app/build/outputs/apk/release/*.apk -Name | select -first 1)\""
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-native-clipboard/clipboard": "1.11.2",
    "@react-native-community/checkbox": "0.5.20",
    "@react-native-firebase/app": "18.0.0",
    "@react-native-firebase/messaging": "^18.0.0",
    "@react-native/new-app-screen": "0.81.6",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "deprecated-react-native-prop-types": "2.3.0",
    "html-entities": "2.6.0",
    "react": "19.1.4",
    "react-native": "0.81.6",
    "react-native-cache": "2.0.3",
    "react-native-config": "1.4.11",
    "react-native-device-info": "10.6.0",
    "react-native-encrypted-storage": "4.0.3",
    "react-native-geocoding": "0.5.0",
    "react-native-gesture-handler": "^2.24.0",
    "react-native-maps": "1.3.2",
    "react-native-reanimated": "^3.19.5",
    "react-native-safe-area-context": "^5.3.0",
    "react-native-screens": "4.18.0",
    "react-native-vector-icons": "9.2.0",
    "recoil": "0.7.6",
    "rollbar-react-native": "0.9.3"
  },
  "devDependencies": {
    "@babel/core": "7.21.8",
    "@babel/plugin-proposal-private-methods": "7.18.6",
    "@babel/plugin-transform-flow-strip-types": "7.21.0",
    "@babel/preset-env": "7.21.5",
    "@babel/runtime": "7.21.5",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native-community/eslint-config": "3.2.0",
    "@react-native/babel-preset": "0.81.6",
    "@react-native/eslint-config": "0.81.6",
    "@react-native/metro-config": "0.81.6",
    "@react-native/typescript-config": "0.81.6",
    "@types/jest": "29.5.1",
    "@types/react": "^19.1.4",
    "@types/react-native": "0.70.13",
    "@types/react-native-vector-icons": "6.4.13",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "babel-jest": "29.5.0",
    "eslint": "8.57.0",
    "jest": "29.5.0",
    "metro-react-native-babel-preset": "0.75.1",
    "patch-package": "^8.0.1",
    "prettier": "2.7.1",
    "react-test-renderer": "19.1.0",
    "typescript": "^5.8.3"
  },
  "resolutions": {
    "@types/react": "^17"
  },
  "jest": {
    "preset": "react-native",
    "verbose": true,
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "setupFiles": [
      "<rootDir>/testSetup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/?!(rollbar-react-native)"
    ],
    "modulePathIgnorePatterns": [
      "__tests__/resources"
    ]
  }
}
